<main data-controller="mic" class="card">
  <h1>MicBridge</h1>
  <div class="state" data-mic-target="badge" data-state="idle"></div>
  <p data-mic-target="status" class="status">Desconectado</p>
  <canvas data-mic-target="meter" width="300" height="14"></canvas>
  <button data-mic-target="button" data-action="mic#toggle">Iniciar microfone</button>
</main>
